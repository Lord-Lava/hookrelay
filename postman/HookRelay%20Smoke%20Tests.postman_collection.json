{
  "info": {
    "name": "HookRelay Smoke Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mutating tests for an isolated development environment; requires API keys for two different projects. Creates unique endpoints and deletes them on success. Events and audit history remain."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "invalid_api_key",
      "value": "invalid"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('runId')) {",
          "    ['api_key', 'other_api_key', 'project_id'].forEach(function (name) {",
          "        const value = pm.environment.get(name);",
          "        if (!value || value.includes('PLACEHOLDER')) throw new Error('Configure ' + name + ' for an isolated test environment');",
          "    });",
          "    if (pm.environment.get('api_key') === pm.environment.get('other_api_key')) throw new Error('Two distinct project API keys are required');",
          "    pm.variables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create owned endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/endpoints",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://8.8.8.8/hook/{{runId}}\",\n  \"description\": \"Collection test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Save created ID', function () { const b=pm.response.json(); pm.expect(b.id).to.be.a('string'); pm.variables.set('endpointId', b.id); });",
              "pm.test('Secret is returned once and cannot be cached', function () { pm.expect(pm.response.json().signingSecret).to.match(/^whsec_/); pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'); pm.expect(pm.response.text()).not.to.match(/ciphertext|nonce/i); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create foreign endpoint with second project key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{other_api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/endpoints",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://8.8.8.8/hook/{{runId}}/foreign\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Save created ID', function () { const b=pm.response.json(); pm.expect(b.id).to.be.a('string'); pm.variables.set('foreignEndpointId', b.id); });",
              "pm.test('Secret is returned once and cannot be cached', function () { pm.expect(pm.response.json().signingSecret).to.match(/^whsec_/); pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'); pm.expect(pm.response.text()).not.to.match(/ciphertext|nonce/i); });",
              "pm.test('Different project', function () { pm.expect(pm.response.json().projectId).not.to.equal(pm.environment.get('project_id')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm foreign endpoint exists for its owner",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{other_api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{foreignEndpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No secret material', function () { pm.expect(pm.response.text()).not.to.match(/signingSecret|whsec_|ciphertext|nonce/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create foreign subscription with its owner key",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{other_api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{foreignEndpointId}}/subscriptions/payment.succeeded"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Foreign subscription exists', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing authentication",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/endpoints"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Problem response', function () { const p=pm.response.json(); pm.expect(p.status).to.equal(pm.response.code); pm.expect(p).to.have.property('detail'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List owned endpoints",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints?page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No secret material', function () { pm.expect(pm.response.text()).not.to.match(/signingSecret|whsec_|ciphertext|nonce/); });",
              "pm.test('Page and tenant', function () { const b=pm.response.json(); pm.expect(b).to.have.all.keys('endpoints','page','size','total'); pm.expect(b.endpoints.some(e => e.id === pm.variables.get('endpointId'))).to.equal(true); b.endpoints.forEach(e => pm.expect(e.projectId).to.equal(pm.environment.get('project_id'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get owned endpoint",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No secret material', function () { pm.expect(pm.response.text()).not.to.match(/signingSecret|whsec_|ciphertext|nonce/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cross-project GET endpoint",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{foreignEndpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Problem response', function () { const p=pm.response.json(); pm.expect(p.status).to.equal(pm.response.code); pm.expect(p).to.have.property('detail'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update owned endpoint",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No secret material', function () { pm.expect(pm.response.text()).not.to.match(/signingSecret|whsec_|ciphertext|nonce/); });",
              "pm.test('Description updated', function () { pm.expect(pm.response.json().description).to.equal('Updated'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Disable owned endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/disable"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Enable owned endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/enable"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create subscription",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/subscriptions/payment.succeeded"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.variables.set('subscriptionId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay subscription",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/subscriptions/payment.succeeded"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Same subscription', function () { pm.expect(pm.response.json().id).to.equal(pm.variables.get('subscriptionId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List subscriptions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/subscriptions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Subscription page', function () { const b=pm.response.json(); pm.expect(b).to.have.all.keys('subscriptions','page','size','total'); pm.expect(b.subscriptions.map(s=>s.id)).to.include(pm.variables.get('subscriptionId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Rotate owned secret",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/rotate-secret"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Secret is returned once and cannot be cached', function () { pm.expect(pm.response.json().signingSecret).to.match(/^whsec_/); pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'); pm.expect(pm.response.text()).not.to.match(/ciphertext|nonce/i); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read after rotation hides secret",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('No secret material', function () { pm.expect(pm.response.text()).not.to.match(/signingSecret|whsec_|ciphertext|nonce/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete subscription",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}/subscriptions/payment.succeeded"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Ingest event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}"
          }
        ],
        "url": "{{base_url}}/v1/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"payment.succeeded\",\n  \"data\": {\n    \"synthetic\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', function () { pm.response.to.have.status(202); });",
              "pm.variables.set('eventId',pm.response.json().eventId); pm.test('First acceptance',function(){pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.equal('false');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay identical event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}"
          }
        ],
        "url": "{{base_url}}/v1/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"payment.succeeded\",\n  \"data\": {\n    \"synthetic\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', function () { pm.response.to.have.status(202); });",
              "pm.test('Idempotent replay',function(){pm.expect(pm.response.json().eventId).to.equal(pm.variables.get('eventId'));pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.equal('true');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup endpointId",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cleanup foreignEndpointId",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{other_api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{foreignEndpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted endpoint unavailable",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/v1/endpoints/{{endpointId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Problem response', function () { const p=pm.response.json(); pm.expect(p.status).to.equal(pm.response.code); pm.expect(p).to.have.property('detail'); });"
            ]
          }
        }
      ]
    }
  ]
}
