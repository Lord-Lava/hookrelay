{
  "info": {
    "name": "HookRelay Smoke Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mutating tests for an isolated development environment; requires API keys for two different projects. Creates unique endpoints and deletes them on success. Events and audit history remain."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "invalid_api_key",
      "value": "invalid"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('runId')) {",
          "    ['api_key', 'other_api_key', 'project_id'].forEach(function (name) {",
          "        const value = pm.environment.get(name);",
          "        if (!value || value.includes('PLACEHOLDER')) throw new Error('Configure ' + name + ' for an isolated test environment');",
          "    });",
          "    if (pm.environment.get('api_key') === pm.environment.get('other_api_key')) throw new Error('Two distinct project API keys are required');",
          "    pm.variables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create owned endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/endpoints",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://8.8.8.8/hook/{{runId}}\",\n  \"description\": \"Collection test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Save created ID', function () { const b=pm.response.json(); pm.expect(b.id).to.be.a('string'); pm.variables.set('endpointId', b.id); });",
              "pm.test('Secret is returned once and cannot be cached', function () { pm.expect(pm.response.json().signingSecret).to.match(/^whsec_/); pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'); pm.expect(pm.response.text()).not.to.match(/ciphertext|nonce/i); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create endpoint beyond capacity returns 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/endpoints",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://8.8.8.8/cap-initial\",\n  \"description\": \"Capacity test initial\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var createdIds = [];",
              "var maxAttempts = 1050;",
              "var attempt = 0;",
              "",
              "function createNext() {",
              "  attempt++;",
              "  if (attempt > maxAttempts) {",
              "    pm.test('Capacity limit reached within ' + maxAttempts + ' attempts', function () {",
              "      pm.expect(false).to.be.true;",
              "    });",
              "    return cleanup();",
              "  }",
              "",
              "  var request = {",
              "    url: pm.variables.get('base_url') + '/v1/endpoints',",
              "    method: 'POST',",
              "    header: [",
              "      { key: 'X-Api-Key', value: '{{api_key}}' },",
              "      { key: 'Content-Type', value: 'application/json' }",
              "    ],",
              "    body: {",
              "      mode: 'raw',",
              "      raw: JSON.stringify({",
              "        url: 'https://8.8.8.8/cap-' + pm.variables.get('runId') + '-' + attempt,",
              "        description: 'Capacity test ' + attempt",
              "      }),",
              "      options: { raw: { language: 'json' } }",
              "    }",
              "  };",
              "",
              "  pm.sendRequest(request, function (err, res) {",
              "    if (err) {",
              "      console.log('Request error:', err);",
              "      createNext();",
              "      return;",
              "    }",
              "",
              "    if (res.code === 201) {",
              "      try {",
              "        var body = res.json();",
              "        if (body && body.id) createdIds.push(body.id);",
              "      } catch (e) {}",
              "      createNext();",
              "    } else if (res.code === 409) {",
              "      var detail = '';",
              "      try { detail = res.json().detail || ''; } catch (e) {}",
              "      pm.test('Capacity limit enforced with 409', function () {",
              "        pm.expect(res.code).to.equal(409);",
              "        pm.expect(detail).to.include('1000');",
              "      });",
              "      cleanup();",
              "    } else {",
              "      pm.test('Unexpected response during capacity test', function () {",
              "        pm.expect(res.code).to.be.oneOf([201, 409]);",
              "      });",
              "      createNext();",
              "    }",
              "  });",
              "}",
              "",
              "function cleanup() {",
              "  var i = 0;",
              "  function deleteNext() {",
              "    if (i >= createdIds.length) {",
              "      pm.test('Created ' + createdIds.length + ' endpoints before capacity limit', function () {",
              "        pm.expect(createdIds.length).to.be.above(900);",
              "      });",
              "      return;",
              "    }",
              "    pm.sendRequest({",
              "      url: pm.variables.get('base_url') + '/v1/endpoints/' + createdIds[i],",
              "      method: 'DELETE',",
              "      header: [ { key: 'X-Api-Key', value: '{{api_key}}' } ]",
              "    }, function () {",
              "      i++;",
              "      deleteNext();",
              "    });",
              "  }",
              "  deleteNext();",
              "}",
              "",
              "createNext();"
            ]
          }
        }
      ]
    },
