    },
    {
      "name": "Smoke: Subscription Management",
      "item": [
        {
          "name": "Smoke: Create subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/endpoints/{{smokeEndpointId}}/subscriptions/payment.succeeded",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "endpoints",
                "{{smokeEndpointId}}",
                "subscriptions",
                "payment.succeeded"
              ]
            },
            "description": "Creates a subscription on the smoke test endpoint. Expects 201 Created."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"Response has subscription ID\", function () {",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.id).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"smokeSubscriptionId\", json.id);",
                  "});",
                  "",
                  "pm.test(\"Response has eventType payment.succeeded\", function () {",
                  "    pm.expect(json.eventType).to.equal(\"payment.succeeded\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Smoke: Idempotent duplicate subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/endpoints/{{smokeEndpointId}}/subscriptions/payment.succeeded",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "endpoints",
                "{{smokeEndpointId}}",
                "subscriptions",
                "payment.succeeded"
              ]
            },
            "description": "Creates the same subscription again. Expects 200 OK with same ID."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"Response returns same subscription ID\", function () {",
                  "    pm.expect(json.id).to.equal(pm.collectionVariables.get(\"smokeSubscriptionId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Smoke: List subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/endpoints/{{smokeEndpointId}}/subscriptions?page=0&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "endpoints",
                "{{smokeEndpointId}}",
                "subscriptions"
              ],
              "query": [
                {
                  "key": "page",
